# Chaves aceitas pelo provider-fake. Não são segredos reais: só funcionam contra ele.
# Usadas pelo provider-fake e pelo gateway (LiteLLM). A APLICAÇÃO não as enxerga.
FAKE_OPENAI_KEY=sk-fake-openai-0001
FAKE_ANTHROPIC_KEY=sk-ant-fake-0001

# Gateway de IA (LiteLLM Proxy)
# master_key: administra o gateway (criar virtual keys, ver gastos). Nunca vai ao app.
GATEWAY_MASTER_KEY=sk-gateway-master-0001
# Virtual key da APLICAÇÃO: tem budget e só pode usar as 4 capacidades lógicas.
# É a única chave que o serviço `app` recebe.
GATEWAY_API_KEY=sk-helpdesk-app-0001
# Virtual key de DEMONSTRAÇÃO de governança: tem limite de requisições por minuto.
# Serve para provar que o gateway recusa requisições fora do limite.
GATEWAY_LIMITED_KEY=sk-helpdesk-rpm-demo-0001
